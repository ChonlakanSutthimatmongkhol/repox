class {{.Class "screen"}} extends {{if $screen.BaseClass}}{{$screen.BaseClass}}{{else}}StatefulWidget{{end}} {
  const {{.Class "screen"}}({super.key});

  @override
  {{if $screen.StateBaseClass}}{{$screen.StateBaseClass}}<{{.Class "screen"}}>{{else}}State<{{.Class "screen"}}>{{end}} createState() => _{{.Class "screen"}}State();
}

class _{{.Class "screen"}}State extends {{if $screen.StateBaseClass}}{{$screen.StateBaseClass}}<{{.Class "screen"}}>{{else}}State<{{.Class "screen"}}>{{end}} {
  @override
  void initState() {
    super.initState();
    context.read<{{.Class "bloc"}}>().add(const {{.PascalName}}Started());
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: const Text('{{.PascalName}}')),
      body: BlocBuilder<{{.Class "bloc"}}, {{.Class "state"}}>(
        builder: (context, state) {
          return switch (state) {
            {{.PascalName}}Initial() => const SizedBox.shrink(),
            {{.PascalName}}Loading() => const Center(child: CircularProgressIndicator()),
            {{.PascalName}}Loaded() => const Center(child: Text('{{.PascalName}}')),
            {{.PascalName}}Error(:final message) => Center(child: Text(message)),
          };
        },
      ),
    );
  }
}
