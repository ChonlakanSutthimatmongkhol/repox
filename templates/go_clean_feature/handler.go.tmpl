package {{.PackageName}}

import (
	"encoding/json"
	"net/http"
)

type {{.Class "handler"}} struct {
	svc {{.Class "service"}}
}

func New{{.Class "handler"}}(svc {{.Class "service"}}) *{{.Class "handler"}} {
	return &{{.Class "handler"}}{svc: svc}
}

func (h *{{.Class "handler"}}) Get(w http.ResponseWriter, r *http.Request) {
	req := &{{.Class "request"}}{ID: r.URL.Query().Get("id")}
	resp, err := h.svc.Get(r.Context(), req)
	if err != nil {
		http.Error(w, err.Error(), http.StatusInternalServerError)
		return
	}
	w.Header().Set("Content-Type", "application/json")
	json.NewEncoder(w).Encode(resp)
}
